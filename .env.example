DATABASE_URL=postgresql://wcp_local@127.0.0.1:55431/wcp001
BETTER_AUTH_URL=http://127.0.0.1:3100
PORT=3100
HOST=127.0.0.1
# Generate unique local values. Never deploy the demo seed to a public production environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-with-a-local-demo-password
ALLOW_DEMO_SEED=true
# Private file inbox for loopback-only local acceptance. Hosted delivery is configured separately.
ACCOUNT_EMAIL_ADAPTER=local-file
